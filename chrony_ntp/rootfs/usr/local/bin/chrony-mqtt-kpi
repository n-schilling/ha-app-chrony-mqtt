#!/command/with-contenv bashio
# shellcheck shell=bash
# ==============================================================================
# Publishes the server's problem sensors through MQTT discovery; everything
# else is on the web page. Started by the s6 service mqtt-kpi as chronyd's user
# ==============================================================================
readonly NODE='chrony_ntp'
readonly DEV_NAME='Chrony NTP Server'
readonly APP_NAME='Chrony NTP + MQTT'
readonly SUPPORT_URL='https://github.com/n-schilling/ha-app-chrony-mqtt'
readonly TOPIC="chrony/${NODE}"
readonly AVAIL="${TOPIC}/availability"
# Written by the web page on every read of chrony
readonly STATUS=${CHRONY_WEB_STATUS:-/run/chrony-app/status.json}
# Sensors of versions before 2.0.0, now on the web page only; their retained
# states are cleared
readonly GONE=(clients clients/attr clients_active ntp_requests ntp_dropped stratum
    last_sync system_offset rms_offset root_dispersion reference)
# The app's slug, e.g. 0a032ba2_chrony_ntp; the Supervisor names the
# container's host after it
readonly SLUG=${HOSTNAME//-/_}
MODEL="chrony $(chronyd --version | grep -o '[0-9][0-9.]*' | head -1)"
readonly MODEL

PREFIX=$(bashio::config 'discovery_prefix')
DISCOVERY_PREFIX=${PREFIX}
INTERVAL=$(bashio::config 'mqtt_interval')
EXPIRE=$((INTERVAL * 3))
# shellcheck disable=SC2034  # used by mqtt-device.sh
readonly PREFIX DISCOVERY_PREFIX INTERVAL EXPIRE
bashio::config.has_value 'log_level' && bashio::log.level "$(bashio::config 'log_level')"
# The main process, woken by the availability connection after a reconnect
readonly MAIN=$$

bashio::config.require 'mqtt_interval'
bashio::services.available 'mqtt' || bashio::exit.nok 'No MQTT service available'

# The broker and its credentials go into the clients' own option files, one
# option per line, so the password is in no command line (ps, /proc)
MQTT_CONFIG=${MQTT_CONFIG:-/run/chrony-app/mqtt}
(
    umask 077
    mkdir -p "${MQTT_CONFIG}"
    {
        echo "-h $(bashio::services mqtt 'host')"
        echo "-p $(bashio::services mqtt 'port')"
        if bashio::var.has_value "$(bashio::services mqtt 'username')"; then
            echo "-u $(bashio::services mqtt 'username')"
            echo "-P $(bashio::services mqtt 'password')"
        fi
        # A broker with TLS: its certificate is checked against the system's CAs
        if bashio::var.true "$(bashio::services mqtt 'ssl')"; then
            echo '--capath /etc/ssl/certs'
        fi
    } > "${MQTT_CONFIG}/mosquitto_pub"
    cp "${MQTT_CONFIG}/mosquitto_pub" "${MQTT_CONFIG}/mosquitto_sub"
)
export XDG_CONFIG_HOME=${MQTT_CONFIG}
# Further options for every client; the broker comes from the files above
declare -a MQ=()
readonly MQ

pub() { mosquitto_pub "${MQ[@]}" -r -t "$1" -s; }

# shellcheck source=../lib/mqtt-device.sh
source /usr/local/lib/mqtt-device.sh

# Waits in the background, so the stop trap runs at once and not only after
# the interval (the tests bring their own pause)
declare -F pause > /dev/null || pause() { sleep "$1" & wait $!; }

# --- Availability ---------------------------------------------------------------
# A connection held open with a last will: if the app dies, the broker marks
# the entities unavailable. A regular stop publishes "offline" itself.
# When the connection broke, the broker has sent the last will meanwhile (or
# lost its retained messages): after the reconnect the main process is woken
# to announce the device and publish "online" and the states at once.
HOLD_SUB=''
hold_availability() {
    trap '[[ -n "${HOLD_SUB}" ]] && kill "${HOLD_SUB}" 2>/dev/null; exit 0' TERM
    local again=''
    while true; do
        mosquitto_sub "${MQ[@]}" -i "${SLUG}-availability" -q 1 -t "${AVAIL}" \
            --will-topic "${AVAIL}" --will-payload offline --will-retain --will-qos 1 \
            > /dev/null 2>&1 &
        HOLD_SUB=$!
        if [[ -n "${again}" ]]; then
            sleep 2
            kill -0 "${HOLD_SUB}" 2>/dev/null && kill -USR1 "${MAIN}" 2>/dev/null
        fi
        # bashio sets errexit: a broken connection must not end the loop
        wait "${HOLD_SUB}" || true
        again=1
        sleep 10
    done
}

HOLDER=''
stop() {
    trap - EXIT TERM INT
    # Without a broker the last will of the held connection says offline
    printf 'offline' | pub "${AVAIL}" 2> /dev/null || true
    [[ -n "${HOLDER}" ]] && kill "${HOLDER}" 2>/dev/null
    exit 0
}

# --- Discovery, once and retained ---------------------------------------------
# One message for the device with all entities; discover() adds one entity
# $1 object_id  $2 display name  $3 platform  $4 extra JSON keys
COMPONENTS='{}'
discover() {
    COMPONENTS=$(jq -c --arg k "$1" --arg name "$2" --arg p "$3" --arg uid "${NODE}_$1" \
        --arg stt "${TOPIC}/$1" --argjson exp "${EXPIRE}" --argjson extra "${4:-\{\}}" \
        '.[$k] = ({platform:$p, name:$name, unique_id:$uid, state_topic:$stt, expire_after:$exp} + $extra)' \
        <<< "${COMPONENTS}")
}

publish_discovery() {
    COMPONENTS='{}'
    discover sync_problem   'Sync problem'         binary_sensor \
        '{"device_class":"problem","payload_on":"ON","payload_off":"OFF"}'
    discover requests_missing 'NTP requests missing' binary_sensor \
        '{"device_class":"problem","payload_on":"ON","payload_off":"OFF"}'
    md_announce "${NODE}" "$(jq -nc --argjson c "${COMPONENTS}" --arg avail "${AVAIL}" \
        --arg dev "${DEV_NAME}" --arg model "${MODEL}" --arg cfg "homeassistant://config/app/${SLUG}/info" \
        --arg app "${APP_NAME}" --arg version "${APP_VERSION:-unknown}" --arg url "${SUPPORT_URL}" \
        '{device:{identifiers:["chrony_ntp"], name:$dev, manufacturer:"chrony", model:$model,
                  configuration_url:$cfg},
          origin:{name:$app, sw_version:$version, support_url:$url},
          availability_topic:$avail, qos:1, components:$c}')" \
        "${PREFIX}/+/${NODE}/+/config" 2> /dev/null || return 1
    bashio::log.info 'Device announced through MQTT discovery'
    # Housekeeping only: a broker that does not take it is no reason to stop
    local t
    for t in "${GONE[@]}"; do
        md_clear "${TOPIC}/${t}" 2> /dev/null || true
    done
}

# The web page judges from the clients it keeps across restarts; without a
# fresh status from it the state is unknown
requests_missing() {
    jq -r --argjson now "$(date +%s)" \
        'if (.at // 0) >= $now - 120 then (if .requests_missing then "ON" else "OFF" end) else "None" end' \
        "${STATUS}" 2>/dev/null || echo None
}

publish_state() {
    # Fields of `chronyc -c tracking`; _ marks the ones not needed
    local refid stratum leap
    IFS=, read -r refid _ stratum _ _ _ _ _ _ _ _ _ _ leap < <(chronyc -c tracking) || return 1

    # 7F7F0101 is chrony's own clock (serve_when_offline): no upstream source
    local problem=OFF
    [[ "${stratum}" -ge 16 || "${leap}" != "Normal" || "${refid}" == 7F7F0101 ]] && problem=ON
    local missing
    missing=$(requests_missing)

    local t="${TOPIC}"
    local -a states=(
        "${t}/sync_problem"     "${problem}"
        "${t}/requests_missing" "${missing}"
        # Again on every update, in case the broker lost its retained messages
        "${AVAIL}"              online
    )
    # The first message the broker does not take ends the round: the rest
    # would fail the same way and only fill the log
    local i
    for (( i = 0; i < ${#states[@]}; i += 2 )); do
        if ! PUB_ERROR=$(printf '%s' "${states[i + 1]}" | pub "${states[i]}" 2>&1); then
            return 2
        fi
    done

    bashio::log.debug "Sync problem ${problem}, requests missing ${missing}"
}

# Right after a start chrony has no source yet (stratum 0); give it up to two
# minutes, so the first update does not report a sync problem that is none
wait_for_sync() {
    local stratum
    for _ in $(seq 1 24); do
        stratum=$(chronyc -c tracking 2>/dev/null | cut -d, -f3)
        [[ "${stratum}" =~ ^[0-9]+$ ]] && (( stratum > 0 && stratum < 16 )) && return 0
        sleep 5
    done
    bashio::log.warning 'chrony not synchronized after two minutes, publishing anyway'
}

hold_availability &
HOLDER=$!
trap stop EXIT TERM INT
# The availability connection reconnected: announce again, publish at once
ANNOUNCED=''
trap 'ANNOUNCED=' USR1

wait_for_sync
bashio::log.info "Key figure publisher running, interval ${INTERVAL}s"
PUB_ERROR=''
FAILING=''
while true; do
    # Until the broker took the device message once, and again after a
    # reconnect; a broker that is not up yet at boot is no reason to give up
    if [[ -z "${ANNOUNCED}" ]]; then
        if publish_discovery; then
            ANNOUNCED=1
        else
            bashio::log.debug 'Discovery not taken, retrying with the next round'
        fi
    fi
    publish_state && result=0 || result=$?
    case ${result} in
        0) failing='' ;;
        1) failing='chronyc' ;;
        *) failing='MQTT broker' ;;
    esac
    # Once per outage, not on every interval
    if [[ "${failing}" != "${FAILING}" ]]; then
        [[ -n "${FAILING}" ]] && bashio::log.info "${FAILING} answers again"
        case ${failing} in
            chronyc) bashio::log.warning 'chronyc query failed, retrying every interval' ;;
            ?*) bashio::log.warning "MQTT broker not reachable (${PUB_ERROR:-no answer}), retrying every interval" ;;
        esac
        FAILING=${failing}
    fi
    # A signal from the availability connection ends the pause early
    pause "${INTERVAL}" || true
done