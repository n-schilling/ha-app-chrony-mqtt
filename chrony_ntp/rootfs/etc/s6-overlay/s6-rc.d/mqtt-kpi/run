#!/bin/sh
# shellcheck shell=sh
# The sensor publisher runs as chronyd's user, not as root: chronyc's command
# socket admits only that user and root. bashio keeps its cache in the app's
# own folder, which init-chrony created for that user.
CACHE_DIR=/run/chrony-app/bashio exec /command/s6-setuidgid chrony /usr/local/bin/chrony-mqtt-kpi
